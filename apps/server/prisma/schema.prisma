// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostedRooms   Room[]  @relation("RoomHost")
  hostedMatches Match[] @relation("MatchHost")
  guestMatches  Match[] @relation("MatchGuest")

  @@map("users")
}

model Room {
  id         String   @id @default(uuid())
  code       String   @unique
  hostId     String
  maxPlayers Int      @default(4)
  status     String   @default("waiting")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host    User    @relation("RoomHost", fields: [hostId], references: [id])
  matches Match[]

  @@map("rooms")
}

model Match {
  id          String    @id @default(uuid())
  roomId      String?
  hostId      String
  guestId     String?
  status      String    @default("waiting")
  winnerId    String?
  gameState   Json?
  playerCount Int       @default(4)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room   Room?  @relation(fields: [roomId], references: [id])
  host   User   @relation("MatchHost", fields: [hostId], references: [id])
  guest  User?  @relation("MatchGuest", fields: [guestId], references: [id])
  events GameEvent[]

  @@map("matches")
}

model GameEvent {
  id        String   @id @default(uuid())
  matchId   String
  type      String
  playerId  String
  payload   Json
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@map("game_events")
}
